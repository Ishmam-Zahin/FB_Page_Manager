# Google Gemini API key
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Meta Graph API version
GRAPH_API_VERSION=v22.0

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Neon PostgreSQL connection string (asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require

# Maximum previous messages sent as conversation history context (default: 5)
CHAT_HISTORY_LIMIT=5
